{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "5.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "checks": {
      "type": "object",
      "properties": {
        "inputs": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "passed",
                "failed",
                "unknown"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1
            },
            "finding_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "status",
            "reason",
            "finding_ids"
          ],
          "additionalProperties": false
        },
        "reverse": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "passed",
                "failed",
                "unknown"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1
            },
            "finding_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "status",
            "reason",
            "finding_ids"
          ],
          "additionalProperties": false
        },
        "requirements": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "passed",
                "failed",
                "unknown"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1
            },
            "finding_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "status",
            "reason",
            "finding_ids"
          ],
          "additionalProperties": false
        },
        "comparison": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "passed",
                "failed",
                "unknown"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1
            },
            "finding_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "status",
            "reason",
            "finding_ids"
          ],
          "additionalProperties": false
        },
        "freshness": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "passed",
                "failed",
                "unknown"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1
            },
            "finding_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "status",
            "reason",
            "finding_ids"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "inputs",
        "reverse",
        "requirements",
        "comparison",
        "freshness"
      ],
      "additionalProperties": false
    },
    "tests": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "passed",
            "failed",
            "not_run",
            "unknown"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "status",
        "reason"
      ],
      "additionalProperties": false
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "cause": {
            "type": "string",
            "enum": [
              "implementation_defect",
              "spec_gap",
              "spec_conflict",
              "intentional_change_candidate",
              "insufficient_evidence"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "recommendation": {
            "type": "string",
            "minLength": 1
          },
          "problem": {
            "type": "string",
            "minLength": 1
          },
          "reverse_change": {
            "type": "string",
            "minLength": 1
          },
          "code": {
            "type": "string",
            "minLength": 1
          },
          "original_change": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "severity",
          "cause",
          "summary",
          "evidence",
          "recommendation",
          "problem",
          "reverse_change",
          "code",
          "original_change"
        ],
        "additionalProperties": false
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "verdict": {
      "type": "string",
      "enum": [
        "unable_to_review",
        "needs_attention",
        "no_material_findings"
      ]
    },
    "change_name": {
      "type": "string",
      "minLength": 1
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "scope",
    "checks",
    "tests",
    "findings",
    "limitations",
    "change_name",
    "questions"
  ],
  "additionalProperties": false
}
