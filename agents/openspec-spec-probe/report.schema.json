{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "6.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "checks": {
      "type": "object",
      "properties": {
        "inputs": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "passed",
                "failed",
                "unknown"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1
            },
            "finding_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "status",
            "reason",
            "finding_ids"
          ],
          "additionalProperties": false
        },
        "observations": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "passed",
                "failed",
                "unknown"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1
            },
            "finding_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "status",
            "reason",
            "finding_ids"
          ],
          "additionalProperties": false
        },
        "requirements": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "passed",
                "failed",
                "unknown"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1
            },
            "finding_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "status",
            "reason",
            "finding_ids"
          ],
          "additionalProperties": false
        },
        "comparison": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "passed",
                "failed",
                "unknown"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1
            },
            "finding_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "status",
            "reason",
            "finding_ids"
          ],
          "additionalProperties": false
        },
        "freshness": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "passed",
                "failed",
                "unknown"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1
            },
            "finding_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "status",
            "reason",
            "finding_ids"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "inputs",
        "observations",
        "requirements",
        "comparison",
        "freshness"
      ],
      "additionalProperties": false
    },
    "tests": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "passed",
            "failed",
            "not_run",
            "unknown"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "status",
        "reason"
      ],
      "additionalProperties": false
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "cause": {
            "type": "string",
            "enum": [
              "implementation_defect",
              "spec_gap",
              "spec_conflict",
              "intentional_change_candidate",
              "insufficient_evidence"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "problem": {
            "type": "string",
            "minLength": 1
          },
          "code": {
            "type": "string",
            "minLength": 1
          },
          "original_change": {
            "type": "string",
            "minLength": 1
          },
          "decision": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "patch"
                  },
                  "target": {
                    "type": "string",
                    "minLength": 1
                  },
                  "before": {
                    "type": "string",
                    "minLength": 1
                  },
                  "after": {
                    "type": "string",
                    "minLength": 1
                  },
                  "basis": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "kind",
                  "target",
                  "before",
                  "after",
                  "basis"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "ask"
                  },
                  "question": {
                    "type": "string",
                    "minLength": 1
                  },
                  "impact": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "kind",
                  "question",
                  "impact"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "keep"
                  },
                  "basis": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "kind",
                  "basis"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "verify"
                  },
                  "missing": {
                    "type": "string",
                    "minLength": 1
                  },
                  "check": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "kind",
                  "missing",
                  "check"
                ],
                "additionalProperties": false
              }
            ]
          },
          "observation_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "id",
          "severity",
          "cause",
          "summary",
          "evidence",
          "problem",
          "code",
          "original_change",
          "decision",
          "observation_ids"
        ],
        "additionalProperties": false
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "verdict": {
      "type": "string",
      "enum": [
        "unable_to_review",
        "needs_attention",
        "no_material_findings"
      ]
    },
    "change_name": {
      "type": "string",
      "minLength": 1
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "scope",
    "checks",
    "tests",
    "findings",
    "limitations",
    "change_name",
    "questions"
  ],
  "additionalProperties": false
}
